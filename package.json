{
  "name": "vecino360",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build:demo": "tsc --noEmit && vite build --mode demo --outDir dist-demo",
    "demo": "vite preview --mode demo --outDir dist-demo --host 127.0.0.1 --port 4186 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run tests/",
    "test:watch": "vitest",
    "server": "node --experimental-strip-types server/index.mjs",
    "dev:shared": "vite --mode shared",
    "build:shared": "tsc --noEmit && vite build --mode shared",
    "test:server": "node --experimental-strip-types --test server/api.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/poppins": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0",
    "ws": "^8.22.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
